# Local course database only. Do not reuse these demonstration passwords on a server.
DATABASE_URL=postgresql://inventory_app:inventory_app_demo@127.0.0.1:55432/inventory
DATABASE_ADMIN_URL=postgresql://postgres:postgres_demo@127.0.0.1:55432/inventory
# Separate operator connection with SELECT on products, audit_logs and operation_receipts.
# Set locally for npm run inspect. Never give the model this connection or owner credentials.
DATABASE_INSPECT_URL=

# Add your own API key locally. It is never needed for npm test or npm run demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_AGENTS_DISABLE_TRACING=1

# Trusted local CLI fixture. A deployed server must derive these from authentication.
DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111
DEMO_USER_ID=course-instructor
DEMO_ROLE=editor
