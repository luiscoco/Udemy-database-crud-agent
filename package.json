{
  "name": "inventory-database-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Course starter: a typed PostgreSQL CRUD agent with approval and audit",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env --import tsx src/cli.ts",
    "db:setup": "node --env-file=.env --import tsx scripts/setup-db.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "demo": "node --env-file=.env --import tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:database": "node --import tsx --test tests/repository.test.ts",
    "test:sdk": "node --import tsx --test tests/agent.test.ts tests/approval-lifecycle.test.ts",
    "check": "npm run typecheck && npm test",
    "eval:live": "node --env-file=.env --import tsx evals/live-agent.ts",
    "inspect": "node --env-file=.env --import tsx scripts/inspect-operation.ts",
    "test:evidence": "node --import tsx --test tests/evidence.test.ts",
    "test:boundary": "node --import tsx --test tests/deployment-boundary.test.ts",
    "test:postgres": "python scripts/test_postgres.py",
    "start:ai": "node --env-file=.env --import tsx src/ai-sdk/cli.ts",
    "test:port": "node --import tsx --test tests/framework-port.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.118",
    "@openai/agents": "0.21.0",
    "ai": "7.0.173",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
